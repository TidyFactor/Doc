{
  "name": "@alwkala/tidyfactor-doc",
  "version": "1.2.0",
  "description": "TidyFactor Doc — Code Documentation Builder & Dual-Engine Publishing Platform (MkDocs Material & Docsify) for AI Coding Agents",
  "main": "bin/add-skill.js",
  "bin": {
    "tidyfactor-doc": "bin/add-skill.js",
    "add-doc-skill": "bin/add-skill.js"
  },
  "keywords": [
    "tidyfactor",
    "docs",
    "docsify",
    "ai-agents",
    "antigravity",
    "claude-code",
    "cursor",
    "documentation-generator"
  ],
  "author": "TidyFactor & Alwkala <hello@tidyfactor.com> (https://alwkala.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TidyFactor/Doc.git"
  },
  "scripts": {
    "validate": "python tools/validate_skill.py",
    "build": "node tools/build-skill.js",
    "release": "python ../tools/release_skill.py ."
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "SKILL.md",
    "references",
    "memory",
    "templates",
    "scripts",
    "tools",
    "assets",
    "bin",
    "brand.json",
    ".tidyfactor",
    "AGENTS.md",
    "README.md",
    "README.ar.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}